# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Force LF line endings for all codebase and config files
*.swift text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.plist text eol=lf
*.pbxproj text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
